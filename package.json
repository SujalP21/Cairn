{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "A source-code hosting platform with version control implemented from scratch",
  "author": "SujalP21",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SujalP21/Cairn.git"
  },
  "bugs": {
    "url": "https://github.com/SujalP21/Cairn/issues"
  },
  "homepage": "https://github.com/SujalP21/Cairn#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overridesComment": "Runtime is Express 4, but @types/cookie-parser depends on @types/express@5. Two copies of express-serve-static-core make third-party RequestHandlers structurally incompatible with ours, so the whole tree is pinned to v4.",
  "overrides": {
    "@types/express": "^4.17.21"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev:api": "npm run dev --workspace @cairn/api",
    "dev:web": "npm run dev --workspace @cairn/web",
    "build:shared": "npm run build --workspace @cairn/shared",
    "build:api": "npm run build --workspace @cairn/api",
    "build:web": "npm run build --workspace @cairn/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "npm run build:shared"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
