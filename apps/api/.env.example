# Copy to .env and fill in. Never commit .env — it is gitignored.
# Every variable below is validated at server startup; the server refuses to
# boot with an actionable error rather than failing at the first request.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port the API listens on. The web client's VITE_API_BASE_URL must agree.
PORT=3002

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Must include the database name as the path segment — it is the single source
# of truth for which database Cairn uses. A URI without one silently falls back
# to "test".
MONGODB_URI=mongodb://127.0.0.1:27017/cairn

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs short-lived access tokens. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Note: this replaces the old JWT_SECRET_KEY. Refresh tokens are opaque random
# strings stored as SHA-256 digests, so they need no signing secret.
JWT_ACCESS_SECRET=

# How long an access token stays valid. Any ms/vercel duration string.
ACCESS_TOKEN_TTL=15m

# How long a refresh token stays valid, in days.
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Credentials
# are enabled, so this cannot be "*". Add your deployed web origin here.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# AWS / S3 — required only for `cairn push` and `cairn pull`
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET=

# Credentials are resolved by the AWS SDK's default provider chain. Prefer an
# IAM role or `aws configure` over putting long-lived keys here; if you must,
# uncomment the two lines below.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
