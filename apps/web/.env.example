# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle. Never
# put a secret here: everything in this file ships to the client.

# Base URL of the Cairn API. Must match the API's PORT, and this app's own
# origin must appear in the API's CORS_ORIGINS — credentials are sent with every
# request, so the API cannot use a wildcard origin.
VITE_API_BASE_URL=http://localhost:3002
